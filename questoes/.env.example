MONGODB_USERNAME=seu_usuario_do_mongodb
MONGODB_PASSWORD=sua_senha_do_mongodb
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=questoes
MONGODB_USERS_COLLECTION=credentials

# Gere uma chave longa e aleatória para produção.
AUTH_SECRET=adicione_uma_chave_secreta_forte

